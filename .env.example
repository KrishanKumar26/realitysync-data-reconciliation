# ---------------------------------------------------------------------------
# RealitySync — example environment
#
# Copy to .env and adjust for your machine:   cp .env.example .env
# .env is git-ignored. NEVER commit real secrets, and never generate a
# production secret here.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# Credentials used by the postgres container AND by the API connection string.
# Keep the two in sync when you change them.
POSTGRES_USER=realitysync
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=realitysync

# Host-side port. Deliberately NOT 5432: a locally installed PostgreSQL
# (Postgres.app, Homebrew) binds 127.0.0.1:5432 and silently wins over
# Docker's wildcard bind, so host tools would connect to the wrong server and
# fail with "role realitysync does not exist". Containers are unaffected —
# they reach each other on the internal port 5432 regardless of this value.
POSTGRES_PORT=5433

# SQLAlchemy async URL (psycopg3 driver).
#   Host "localhost:${POSTGRES_PORT}"  when running the API on your machine.
#   Host "postgres:5432"               when running the API inside Compose.
DATABASE_URL=postgresql+psycopg://realitysync:change-me-locally@localhost:5433/realitysync

# --- Redis -----------------------------------------------------------------
# Redis is never authoritative (Phase 0 §20). Losing it degrades the product;
# it must never corrupt or lose data.
# Host port offset for the same reason as PostgreSQL above.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Application host ports ------------------------------------------------
# Conventional defaults. If another project already holds one of these, change
# it here and update the matching URL below — a busy host port is shadowed
# silently, so the container starts but you reach the wrong application.
#   check with:  lsof -nP -iTCP:3000 -sTCP:LISTEN
API_PORT=8000
WEB_PORT=3000

# --- Public URLs -----------------------------------------------------------
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- CORS ------------------------------------------------------------------
# Explicit allowlist, comma-separated. "*" is rejected at startup because the
# API uses credentialed requests. Must match WEB_PORT above.
CORS_ORIGINS=http://localhost:3000

# --- Cookies ---------------------------------------------------------------
# Environment-driven so staging (cross-site) and production (same-site under a
# shared parent domain) differ only by configuration.
#   local       COOKIE_DOMAIN=          COOKIE_SECURE=false  COOKIE_SAMESITE=lax
#   staging     COOKIE_DOMAIN=          COOKIE_SECURE=true   COOKIE_SAMESITE=none
#   production  COOKIE_DOMAIN=.<domain> COOKIE_SECURE=true   COOKIE_SAMESITE=lax
COOKIE_NAME=rs_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CSRF companion cookie. Deliberately readable by JavaScript — the client must
# copy its value into the request header, and it authenticates nothing on its
# own. The session cookie above is the credential, and it is HttpOnly.
CSRF_COOKIE_NAME=rs_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# --- Sessions --------------------------------------------------------------
# Two independent limits. The absolute lifetime bounds how long a stolen cookie
# is useful; the idle timeout ends a session nobody is using. The idle timeout
# must not exceed the lifetime — startup rejects that combination.
SESSION_LIFETIME_SECONDS=1209600      # 14 days
SESSION_IDLE_TIMEOUT_SECONDS=86400    # 24 hours

# --- Password policy -------------------------------------------------------
PASSWORD_MIN_LENGTH=12

# --- Argon2id --------------------------------------------------------------
# OWASP Password Storage Cheat Sheet recommendation: 19 MiB, t=2, p=1.
# Raise the cost on faster hardware — existing hashes upgrade automatically on
# the owner's next successful sign-in.
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1

# --- Secrets ---------------------------------------------------------------
# Local placeholder only. Production startup fails if this is left unchanged.
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

# --- Frontend (build-time; must be NEXT_PUBLIC_ to reach the browser) -------
# Never place a secret behind a NEXT_PUBLIC_ prefix — it ships to the client.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
