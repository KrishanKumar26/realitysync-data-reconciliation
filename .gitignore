# ---------------------------------------------------------------------------
# RealitySync — project-scoped ignore rules
# ---------------------------------------------------------------------------

# --- Secrets (never commit) ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.hypothesis/

# --- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/
coverage/
.eslintcache
next-env.d.ts

# --- Docker ----------------------------------------------------------------
.docker/
docker-compose.override.yml

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Logs / local scratch --------------------------------------------------
*.log
logs/
tmp/
.scratch/

# --- Personal files — defence in depth -------------------------------------
# These must never appear in this repository. The project root is
# /Users/<user>/Desktop/Project2; these patterns exist so that an accidental
# `git add` from a parent directory cannot stage personal data.
.ssh/
.gnupg/
.aws/
.config/
.claude/
.claude.json
.gitconfig
.zsh_history
.bash_history
.psql_history
.mysql_history
.python_history
.lesshst
.viminfo
.netrc
.pgpass
